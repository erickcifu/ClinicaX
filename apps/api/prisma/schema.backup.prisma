  documentos               documentos[]
  historial_medico         historial_medico?
  historial_odontologico   historial_odontologico?
  odontogramas             odontogramas[]
  paciente_cuentas_usuario paciente_cuentas_usuario?
  paciente_enfermedades    paciente_enfermedades[]
  clinicas                 clinicas                   @relation(fields: [id_clinica], references: [id_clinica], onDelete: NoAction, onUpdate: NoAction, map: "fk_pacientes_clinica")
  pagos                    pagos[]
  planes_tratamiento       planes_tratamiento[]
  recetas                  recetas[]
  signos_vitales           signos_vitales[]

  @@unique([id_clinica, codigo_expediente], map: "uq_pacientes_clinica_expediente")
  @@unique([id_clinica, id_paciente], map: "uq_pacientes_clinica_paciente")
  @@unique([id_clinica, dpi], map: "uq_pacientes_dpi_clinica", where: raw("((dpi IS NOT NULL) AND (fecha_eliminacion IS NULL))"))
  @@index([id_clinica, apellidos, nombres], map: "ix_pacientes_clinica_nombre")
  @@index([id_clinica, telefono], map: "ix_pacientes_telefono")
}

