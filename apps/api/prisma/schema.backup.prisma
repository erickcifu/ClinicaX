  pacientes      pacientes  @relation(fields: [id_clinica, id_paciente], references: [id_clinica, id_paciente], onDelete: NoAction, onUpdate: NoAction, map: "fk_documentos_paciente")
  usuarios       usuarios?  @relation(fields: [id_clinica, id_subido_por], references: [id_clinica, id_usuario], onDelete: NoAction, onUpdate: NoAction, map: "fk_documentos_usuario")

  @@index([id_paciente, fecha(sort: Desc)], map: "ix_documentos_paciente_fecha")
}

model enfermedades {
  id_enfermedad         Int                     @id @default(autoincrement())
  nombre                String                  @unique @db.VarChar(120)
  descripcion           String?
