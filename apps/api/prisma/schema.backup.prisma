  dpi                      String?                    @db.VarChar(25)
  fecha_nacimiento         DateTime?                  @db.Date
  sexo                     String?                    @db.VarChar(30)
  telefono                 String?                    @db.VarChar(30)
  correo                   String?                    @db.VarChar(150)
  direccion                String?
  ocupacion                String?                    @db.VarChar(120)
  contacto_emergencia      String?                    @db.VarChar(150)
  telefono_emergencia      String?                    @db.VarChar(30)
  observaciones            String?
  activo                   Boolean                    @default(true)
