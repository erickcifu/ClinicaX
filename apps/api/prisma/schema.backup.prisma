generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model auditoria {
  id_auditoria BigInt    @id @default(autoincrement())
  id_clinica   BigInt
  id_usuario   BigInt?
  accion       String    @db.VarChar(50)
  entidad      String    @db.VarChar(80)
  id_entidad   String?   @db.VarChar(100)
  detalles     Json      @default("{}")
  ip_origen    String?   @db.Inet
  fecha        DateTime  @default(now()) @db.Timestamptz(6)
  clinicas     clinicas  @relation(fields: [id_clinica], references: [id_clinica], onDelete: NoAction, onUpdate: NoAction, map: "fk_auditoria_clinica")
  usuarios     usuarios? @relation(fields: [id_clinica, id_usuario], references: [id_clinica, id_usuario], onDelete: NoAction, onUpdate: NoAction, map: "fk_auditoria_usuario")

  @@index([id_clinica, fecha(sort: Desc)], map: "ix_auditoria_clinica_fecha")
  @@index([entidad, id_entidad], map: "ix_auditoria_entidad")
}

model categorias_producto {
  id_categoria BigInt      @id @default(autoincrement())
  id_clinica   BigInt
  nombre       String      @db.VarChar(120)
  descripcion  String?
  activo       Boolean     @default(true)
  clinicas     clinicas    @relation(fields: [id_clinica], references: [id_clinica], onDelete: NoAction, onUpdate: NoAction, map: "fk_categorias_clinica")
  productos    productos[]

  @@unique([id_clinica, id_categoria], map: "uq_categorias_clinica_categoria")
  @@unique([id_clinica, nombre], map: "uq_categorias_clinica_nombre")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model citas {
  id_cita                                           BigInt     @id @default(autoincrement())
  id_clinica                                        BigInt
  id_paciente                                       BigInt
  id_odontologo                                     BigInt
  id_creado_por                                     BigInt?
  fecha_hora_inicio                                 DateTime   @db.Timestamptz(6)
  fecha_hora_fin                                    DateTime   @db.Timestamptz(6)
  motivo                                            String?
  estado                                            String     @default("PROGRAMADA") @db.VarChar(25)
  notas                                             String?
  fecha_creacion                                    DateTime   @default(now()) @db.Timestamptz(6)
  fecha_actualizacion                               DateTime   @default(now()) @db.Timestamptz(6)
  usuarios_citas_id_clinica_id_creado_porTousuarios usuarios?  @relation("citas_id_clinica_id_creado_porTousuarios", fields: [id_clinica, id_creado_por], references: [id_clinica, id_usuario], onDelete: NoAction, onUpdate: NoAction, map: "fk_citas_creado_por")
  usuarios_citas_id_clinica_id_odontologoTousuarios usuarios   @relation("citas_id_clinica_id_odontologoTousuarios", fields: [id_clinica, id_odontologo], references: [id_clinica, id_usuario], onDelete: NoAction, onUpdate: NoAction, map: "fk_citas_odontologo")
  pacientes                                         pacientes  @relation(fields: [id_clinica, id_paciente], references: [id_clinica, id_paciente], onDelete: NoAction, onUpdate: NoAction, map: "fk_citas_paciente")
  consultas                                         consultas?

  @@unique([id_clinica, id_cita], map: "uq_citas_clinica_cita")
  @@index([id_clinica, fecha_hora_inicio], map: "ix_citas_clinica_inicio")
  @@index([id_odontologo, fecha_hora_inicio], map: "ix_citas_odontologo_inicio")
  @@index([id_paciente, fecha_hora_inicio], map: "ix_citas_paciente_inicio")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model clinicas {
  id_clinica            BigInt                 @id @default(autoincrement())
  nombre                String                 @db.VarChar(150)
  nit                   String?                @db.VarChar(30)
  direccion             String?
  telefono              String?                @db.VarChar(30)
  correo                String?                @db.VarChar(150)
  logo_url              String?
  zona_horaria          String                 @default("America/Guatemala") @db.VarChar(50)
  estado                String                 @default("ACTIVA") @db.VarChar(20)
  fecha_creacion        DateTime               @default(now()) @db.Timestamptz(6)
  fecha_actualizacion   DateTime               @default(now()) @db.Timestamptz(6)
  auditoria             auditoria[]
  categorias_producto   categorias_producto[]
  configuracion_clinica configuracion_clinica?
  licencias             licencias[]
  pacientes             pacientes[]
  productos             productos[]
  tratamientos          tratamientos[]
  usuarios              usuarios[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model configuracion_clinica {
  id_clinica              BigInt   @id
  duracion_cita_minutos   Int      @default(30) @db.SmallInt
  horas_recordatorio      Int      @default(24) @db.SmallInt
  permite_portal_paciente Boolean  @default(true)
  moneda                  String   @default("GTQ") @db.Char(3)
  configuracion_extra     Json     @default("{}")
  clinicas                clinicas @relation(fields: [id_clinica], references: [id_clinica], onDelete: Cascade, onUpdate: NoAction, map: "fk_configuracion_clinica")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model consentimientos_paciente {
  id_consentimiento BigInt     @id @default(autoincrement())
  id_clinica        BigInt
  id_paciente       BigInt
  id_consulta       BigInt?
  id_registrado_por BigInt?
  tipo              String     @db.VarChar(80)
  version_documento String?    @db.VarChar(30)
  texto_snapshot    String?
  aceptado          Boolean    @default(false)
  fecha_aceptacion  DateTime?  @db.Timestamptz(6)
  firma_url         String?
  ip_origen         String?    @db.Inet
  user_agent        String?
  fecha_creacion    DateTime   @default(now()) @db.Timestamptz(6)
  consultas         consultas? @relation(fields: [id_clinica, id_consulta], references: [id_clinica, id_consulta], onDelete: NoAction, onUpdate: NoAction, map: "fk_consentimiento_consulta")
  pacientes         pacientes  @relation(fields: [id_clinica, id_paciente], references: [id_clinica, id_paciente], onDelete: NoAction, onUpdate: NoAction, map: "fk_consentimiento_paciente")
  usuarios          usuarios?  @relation(fields: [id_clinica, id_registrado_por], references: [id_clinica, id_usuario], onDelete: NoAction, onUpdate: NoAction, map: "fk_consentimiento_usuario")

  @@index([id_paciente, fecha_creacion(sort: Desc)], map: "ix_consentimientos_paciente_fecha")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model consultas {
  id_consulta              BigInt                     @id @default(autoincrement())
  id_clinica               BigInt
  id_paciente              BigInt
  id_odontologo            BigInt
  id_cita                  BigInt?                    @unique(map: "uq_consultas_cita")
  fecha_hora_inicio        DateTime                   @default(now()) @db.Timestamptz(6)
  fecha_hora_fin           DateTime?                  @db.Timestamptz(6)
  motivo_consulta          String?
  diagnostico              String?
  observaciones            String?
  estado                   String                     @default("ABIERTA") @db.VarChar(20)
  fecha_creacion           DateTime                   @default(now()) @db.Timestamptz(6)
  fecha_actualizacion      DateTime                   @default(now()) @db.Timestamptz(6)
  consentimientos_paciente consentimientos_paciente[]
  citas                    citas?                     @relation(fields: [id_clinica, id_cita], references: [id_clinica, id_cita], onDelete: NoAction, onUpdate: NoAction, map: "fk_consultas_cita")
  usuarios                 usuarios                   @relation(fields: [id_clinica, id_odontologo], references: [id_clinica, id_usuario], onDelete: NoAction, onUpdate: NoAction, map: "fk_consultas_odontologo")
  pacientes                pacientes                  @relation(fields: [id_clinica, id_paciente], references: [id_clinica, id_paciente], onDelete: NoAction, onUpdate: NoAction, map: "fk_consultas_paciente")
  documentos               documentos[]
  odontogramas             odontogramas[]
  pagos                    pagos[]
  recetas                  recetas[]
  registros_tratamiento    registros_tratamiento[]
  signos_vitales           signos_vitales[]

  @@unique([id_clinica, id_consulta], map: "uq_consultas_clinica_consulta")
  @@index([id_odontologo, fecha_hora_inicio(sort: Desc)], map: "ix_consultas_odontologo_fecha")
  @@index([id_paciente, fecha_hora_inicio(sort: Desc)], map: "ix_consultas_paciente_fecha")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model dientes {
  id_diente                Int                        @id @default(autoincrement()) @db.SmallInt
  numero_fdi               Int                        @unique @db.SmallInt
  nombre                   String                     @db.VarChar(120)
  denticion                String                     @default("PERMANENTE") @db.VarChar(20)
  activo                   Boolean                    @default(true)
  odontograma_detalle      odontograma_detalle[]
  plan_tratamiento_detalle plan_tratamiento_detalle[]
