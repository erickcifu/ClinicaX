  @@unique([id_paciente, id_enfermedad], map: "uq_paciente_enfermedad_activa", where: raw("(activa = true)"))
}

model pacientes {
  id_paciente              BigInt                     @id @default(autoincrement())
  id_clinica               BigInt
  codigo_expediente        String                     @db.VarChar(30)
  nombres                  String                     @db.VarChar(100)
